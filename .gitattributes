# Rule 30: this repo byte-compares generated artefacts (the vendored checker against the
# playbook's copy) and carries GPL-2.0 patches for upstream, which `patch` rejects with
# "different line endings" when a checkout converts them to CRLF (seen 2026-09-06).
# So the whole tree is LF in the worktree, not only the files pinned individually below.
* text=auto eol=lf

# Kept explicit: these are the files whose byte-identity is actually asserted by a test
# or by an external tool, so the reason for their LF is recorded where it is checked.
tests/conformance.py text eol=lf
tests/test_githubify_conformance.py text eol=lf
scripts/*.sh text eol=lf
*.patch text eol=lf
